{
  "name": "quotebuilder-mcp",
  "version": "1.0.0",
  "description": "MCP Server QuoteBuilder — gérez leads, stats et relances depuis Claude Desktop",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "quotebuilder-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "mcp.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
