{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "quotebuilder.co" }],
      "destination": "https://www.quotebuilder.co/",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "quotebuilder.co" }],
      "destination": "https://www.quotebuilder.co/:path*",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/cron/automations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/catalog-sync",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/ads-sync",
      "schedule": "0 5 * * *"
    }
  ]
}
