NEXT_PUBLIC_SUPABASE_URL=https://spgskgtycqxjziwjpjol.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — never expose to the browser
# Required on Vercel as Sensitive (not in git): SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM=QuoteBuilder <devis@localhost>
CRON_SECRET=

# Chiffrement des accès boutique (WooCommerce / Shopify) et Google Ads.
# Facultatif : à défaut, SUPABASE_SERVICE_ROLE_KEY sert de clé de dérivation.
# La changer rend les connexions existantes illisibles — il faut les reconnecter.
INTEGRATIONS_SECRET_KEY=
# Version de l'API Admin Shopify ciblée (par défaut 2026-07)
SHOPIFY_API_VERSION=

# Google Ads — pont conversions + spend (pas un gestionnaire de campagnes).
# OAuth : https://www.googleapis.com/auth/adwords
# Redirect : {NEXT_PUBLIC_APP_URL}/api/ads/google/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optionnel, ex. v19
GOOGLE_ADS_API_VERSION=
